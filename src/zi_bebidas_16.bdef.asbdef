managed implementation in class zbp_i_bebidas_16 unique;  //este es el behavior base
strict ( 1 );
with draft;

define behavior for ZI_BEBIDAS_16 alias Bebida
persistent table zbebidas_16
draft table zdraft_bebidas16
lock master total etag LastChangedAt
authorization master ( global   )
//etag master <field_name>
{

  create;
  update;
  delete;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;


field ( readonly ) Codigo;
mapping for zbebidas_16
{
Codigo = codigo;
Nombre = nombre;
Tipo = tipo;
Origen = origen;
Graduacion = graduacion;
Precio = precio;
LastChangedAt = last_changed_at;
}
}